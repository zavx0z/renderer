{
  "name": "@zavx0z/renderer-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Lean HTML DOM, document rendering, and WebGPU presentation engine.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun test packages",
    "check": "bun run typecheck && bun run test && bun run capabilities:check",
    "capabilities:refresh": "bun scripts/capabilities/refresh-sources.ts",
    "capabilities:inventory": "bun scripts/capabilities/build-inventories.ts",
    "capabilities:support": "bun scripts/capabilities/build-support-overlays.ts",
    "capabilities:demand": "bun scripts/capabilities/generate-consumer-demand.ts",
    "capabilities:generate": "bun scripts/capabilities/generate.ts",
    "capabilities:rebuild": "bun run capabilities:inventory && bun run capabilities:demand && bun run capabilities:generate",
    "capabilities:typecheck": "tsc -p tsconfig.capabilities.json",
    "capabilities:check": "bun run capabilities:typecheck && bun test scripts/capabilities",
    "bench:dom": "bun bench/dom-memory.ts",
    "bench:renderer": "bun bench/renderer.ts",
    "bench:transform": "bun bench/transform.ts",
    "bench:react": "bun bench/components.ts",
    "bench:react-keyed": "bun bench/keyed-components.ts",
    "bench:instances": "bun bench/instance-batches.ts"
  },
  "devDependencies": {
    "@engine/core": "link:@engine/core",
    "@types/bun": "^1.4.0",
    "@zavx0z/dom": "workspace:*",
    "@zavx0z/react": "workspace:*",
    "@zavx0z/template": "file:../template",
    "typescript": "^7.0.2"
  }
}
