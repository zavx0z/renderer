{
  "name": "@zavx0z/renderer-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Lean HTML DOM, document rendering, and WebGPU presentation engine.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --workspaces typecheck",
    "test": "bun test packages",
    "check": "bun run typecheck && bun run test",
    "bench:dom": "bun bench/dom-memory.ts",
    "bench:renderer": "bun bench/renderer.ts",
    "bench:transform": "bun bench/transform.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
