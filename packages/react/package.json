{
  "name": "@zavx0z/react",
  "version": "0.1.0",
  "description": "Compiled React-shaped components for @zavx0z/dom without React, Fiber or a virtual DOM",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./compatibility": "./src/compatibility.ts",
    "./compatibility.json": "./compatibility.json"
  },
  "scripts": {
    "test": "bun test ./test",
    "typecheck": "tsc -p tsconfig.json --pretty false",
    "check": "bun run typecheck && bun run test"
  },
  "peerDependencies": {
    "@zavx0z/dom": "^0.1.0",
    "@zavx0z/template": "^2.6.2"
  },
  "devDependencies": {
    "@engine/core": "link:@engine/core",
    "@types/bun": "^1.4.0",
    "@webgpu/types": "^0.1.68",
    "@zavx0z/dom": "workspace:*",
    "@zavx0z/renderer": "workspace:*",
    "@zavx0z/renderer-webgpu": "workspace:*",
    "typescript": "^7.0.2"
  }
}
